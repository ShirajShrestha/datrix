# Datrix environment variables. Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string (Atlas free tier works).
MONGODB_URI=

# Shared secret for cron endpoints (/api/cron/news, /api/cron/push). Callers send
# "Authorization: Bearer <CRON_SECRET>". Use a long random string. Also set it as a
# GitHub Actions secret, together with APP_URL (the deployed site URL, no trailing slash).
CRON_SECRET=

# News sources (free tiers).
GUARDIAN_API_KEY=
GNEWS_API_KEY=
MEDIASTACK_API_KEY=
# Optional. MediaStack free plan = 100 calls/MONTH, so each run queries only this many categories
# (rotating daily). Default 3 (~90/month), clamped 0-7, 0 disables MediaStack.
# MEDIASTACK_MAX_CALLS_PER_RUN=3

# Optional. Global cap on brief generations per hour across all stories (default 60).
# BRIEF_MAX_PER_HOUR=60

# Summaries: Groq first, then Gemini, then an extractive fallback.
# The same two keys also power the on-demand story-modal briefs (optional cap: BRIEF_MAX_PER_HOUR).
GROQ_API_KEY=
# Optional. Default: qwen/qwen3.8-27b
GROQ_MODEL=
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
GEMINI_MODEL=

# Web Push (VAPID). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must equal VAPID_PUBLIC_KEY (the browser needs it to subscribe).
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=

# Optional. Cap on stored push subscriptions (default 2000). Over the cap, subscribe returns 503.
# MAX_PUSH_SUBSCRIPTIONS=2000
